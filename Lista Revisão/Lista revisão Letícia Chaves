int hpHeroi = 100;
int hpLich = dado.Next(120, 181); // Lich com HP entre 120 e 180
Console.WriteLine($"\n⚔️ Você entra no covil do Lich! Ele tem {hpLich} de vida.");






int pocaoQtd = 1; // Suponha que o herói tenha uma poção

while (hpHeroi > 0 && hpLich > 0) {
    Console.WriteLine($"\n--- Turno ---\nSeu HP: {hpHeroi} | HP do Lich: {hpLich}");
    Console.Write("Escolha sua ação ([A]tacar / [P]oção): ");
    string acao = Console.ReadLine().ToUpper();

    if (acao == "P" && pocaoQtd > 0) {
        int cura = dado.Next(15, 26); // Cura entre 15 e 25
        hpHeroi += cura;
        pocaoQtd--;
        Console.WriteLine($"Você usou uma poção e recuperou {cura} de HP. ({pocaoQtd} restante)");
    } else if (acao == "A") {
        int danoHeroi = dado.Next(10, 21);
        hpLich -= danoHeroi;
        Console.WriteLine($"Você ataca e causa {danoHeroi} de dano!");
    } else {
        Console.WriteLine("Ação inválida ou sem poções.");
    }

    // Lich ataca se ainda estiver vivo
    if (hpLich > 0) {
        int danoLich = dado.Next(10, 16);
        hpHeroi -= danoLich;
        Console.WriteLine($"O Lich ataca com magia sombria! Você sofre {danoLich} de dano.");
    }






if (hpLich > 0 && hpLich < 50) {
        int chanceFeitico = dado.Next(1, 101); // 1 a 100
        if (chanceFeitico <= 50) {
            int danoExtra = 30;
            hpHeroi -= danoExtra;
            Console.WriteLine(" O Lich lança seu Feitiço Desesperado! Você sofre +30 de dano!");
        }
    }
}







